{
  "manifest_version": 3,
  "name": "Jira Task Dashboard",
  "version": "1.0.0",
  "description": "View and filter your Jira tasks from a popup dashboard",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.atlassian.net/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "public/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
